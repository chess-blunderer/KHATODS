# Copy this file to ".env" and fill in your own values. This example file IS committed to GitHub.
PORT=3000
NODE_ENV=development

# Websites that are allowed to call this backend (comma separated, no spaces needed).
# 5500 = VS Code Live Server, 8000 = python -m http.server
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
